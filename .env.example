# Copy to .env for local work. Real values live in Wrangler secrets.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Local docker-compose Postgres. In production this is the Neon pooled URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adaptive

# 32 chars minimum. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-this-value-is-at-least-32-characters-long
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000"]

# Phase 0 runs with AI off. Every AI path returns fixtures and still writes
# an ai_runs row, so the audit trail is exercised without spending tokens.
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

MEDIA_BUCKET=adaptive-media
