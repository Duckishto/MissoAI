{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "adaptive-api",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-05",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"workers_dev": true,
	"preview_urls": false,
	"containers": [
		{
			"class_name": "Backend",
			"image": "./Dockerfile",
			"max_instances": 3,
			"instance_type": "standard-1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "Backend",
				"name": "BACKEND"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Backend"
			]
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "adaptive-media"
		}
	],
	"vars": {
		"ENVIRONMENT": "production",
		"AI_ENABLED": "true",
		"ALLOWED_ORIGINS": "[\"https://adaptive-web.rondopuffin.workers.dev\"]"
	},
	// Secrets, set with `wrangler secret put NAME --env=""`, never in this file:
	//   DATABASE_URL, JWT_SECRET, AI_API_KEY
	"env": {
		"preview": {
			"name": "adaptive-api-preview",
			"workers_dev": true,
			"preview_urls": false,
			"vars": {
				"ENVIRONMENT": "preview",
				"AI_ENABLED": "false",
				"ALLOWED_ORIGINS": "[\"https://adaptive-web-preview.rondopuffin.workers.dev\"]"
			},
			"containers": [
				{
					"class_name": "Backend",
					"image": "./Dockerfile",
					"max_instances": 1,
					"instance_type": "dev"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "adaptive-media-preview"
				}
			]
		}
	}
}
