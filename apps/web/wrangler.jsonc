{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "adaptive-web",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-05",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": true
	},
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "NEXT_INC_CACHE_KV",
			"id": "09ac0bbe64f2414c9f21b1a99c94b12c"
		}
	],
	// The browser bundle does not read this. NEXT_PUBLIC_* is compiled in at
	// build time from apps/web/.env.production; this entry only gives the
	// Worker the value at runtime.
	"vars": {
		"NEXT_PUBLIC_API_URL": "https://adaptive-api.rondopuffin.workers.dev"
	}
}
